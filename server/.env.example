NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/careconnect
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:3000
NIT_EMAIL_DOMAIN=nitrr.ac.in
# Set these temporarily, then run npm run seed:admin from /server to provision the first admin.
ADMIN_NAME=CareConnect Administrator
ADMIN_EMAIL=admin@nitrr.ac.in
ADMIN_PASSWORD=use-a-unique-12-character-or-longer-password

# Razorpay Standard Checkout. Test: rzp_test_*. Live: rzp_live_*.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Live payments require NODE_ENV=production, HTTPS and this explicit acknowledgement.
RAZORPAY_LIVE_ENABLED=false
# Local development only. Disabled unless explicitly set to true.
ALLOW_MOCK_PAYMENTS=false
# Set this same secret in Razorpay Dashboard → Webhooks.
RAZORPAY_WEBHOOK_SECRET=

# Optional Cloudinary uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional SMTP email notifications
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=CareConnect <no-reply@example.com>
